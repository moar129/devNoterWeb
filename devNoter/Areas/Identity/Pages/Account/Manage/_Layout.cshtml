@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4">
    <!-- Page Title -->
    <div class="mb-3 mb-sm-0">
        <h1 class="display-6 mb-0 fw-semibold text-dark">
            Manage your account
        </h1>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex flex-column flex-sm-row gap-2 ms-sm-auto">
        <a asp-page="/Index"
           class="btn btn-outline-secondary w-100 w-sm-auto px-3">
            ← Back to Home
        </a>

        <form id="logoutForm"
              asp-area="Identity"
              asp-page="/Account/Logout"
              method="post"
              class="d-inline">
            <button type="submit"
                    class="btn btn-outline-danger w-100 w-sm-auto px-3">
                Log out
            </button>
        </form>
    </div>
</div>


<div>
    <hr />
    <div class="row">
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
