@inject devNoter.Service.LanguageFolderService FolderService
@inject Microsoft.AspNetCore.Identity.UserManager<devNoter.Models.ApplicationUser> UserManager
@{
    var isLoggedIn = User.Identity.IsAuthenticated;
    List<devNoter.Models.LanguageFolder> folders = new();

    if (isLoggedIn)
    {
        var user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            // Load only top-level folders (ParentFolderId == null)
            folders = (await FolderService.GetLanguageFoldersForUserAsync(user.Id))
                        .Where(f => f.ParentFolderId == null)
                        .ToList();
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DevNoter</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- CodeMirror CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css" />
</head>
<body>
    <header></header>

    @if (isLoggedIn)
    {
            <!-- Mobile Burger Button -->
            <button class="btn btn-outline-secondary d-md-none m-3"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#mobileSidebar"
                    aria-controls="mobileSidebar">
                ☰ Menu
            </button>

            <div class="d-flex min-vh-100">
                <!-- Fixed Sidebar for md+ -->
                <div class="d-none d-md-flex flex-column flex-shrink-0 p-3 bg-light border-end" style="width: 250px;">
                    <h1 class="fw-bold mb-4">
                        <a class="navbar-brand text-black text-decoration-none" asp-area="" asp-page="/Index">DevNoter</a>
                    </h1>

                    <div class="d-flex justify-content-between align-items-center fw-bold mb-3">
                        <span>Folders</span>
                        <a class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#createFolderModal">+</a>
                    </div>

                    <ul class="nav nav-pills flex-column mb-auto">
                    @foreach (var folder in folders.Where(f => f.ParentFolderId == null))
                    {
                        @await Html.PartialAsync("_FolderItem", folder)
                    }
                    </ul>
                </div>

                <!-- Offcanvas Sidebar for mobile -->
                <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar">
                    <div class="offcanvas-header">
                        <a class="text-black text-decoration-none" asp-page="/Index"><h5 class="offcanvas-title">DevNoter</h5></a>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body">
                        <div class="d-flex justify-content-between align-items-center fw-bold mb-3">
                            <span>Folders</span>
                            <a class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#createFolderModal">+</a>
                        </div>

                        <ul class="nav nav-pills flex-column mb-auto">
                        @foreach (var folder in folders)
                        {
                                    <li class="nav-item d-flex justify-content-between align-items-center mb-1">
                                        <a asp-page="/Notes/GetAllNotes" asp-route-id="@folder.Id" class="nav-link text-dark text-decoration-hover-underline">@folder.Name</a>
                                        <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteFolderModal-@folder.Id">–</button>
                                    </li>
                        }
                        </ul>
                    </div>
                </div>

                <!-- Create Folder Modal At The Top-->
                <div class="modal fade" id="createFolderModal" tabindex="-1" aria-labelledby="createFolderModalLabel" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="post" asp-page="/LanguageFolder/CreateLanguageFolder">
                                <div class="modal-header">
                                    <h5 class="modal-title fw-bold" id="createFolderModalLabel">Create New Folder</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label for="LanguageFolder_Name" class="form-label">Folder Name</label>
                                        <input type="text" id="LanguageFolder_Name" name="LanguageFolder.Name" class="form-control" required>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">Create</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>


                <!-- Main Content -->
                <div class="container-fluid mt-2">
                    <ul class="nav justify-content-end mb-3">
                        <li class="nav-item">
                            <a href="/Identity/Account/Manage" class="btn btn-dark rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                               style="width: 40px; height: 40px;">
                                <i class="bi bi-person-fill fs-4"></i>
                            </a>
                        </li>
                    </ul>

                    <main role="main" class="pb-3">
                    @RenderBody()
                    </main>
                </div>
            </div>

            <footer class="border-top footer text-muted mt-auto">
                <div class="container">
                    &copy; 2025 - DevNoter - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </div>
            </footer>
    }
    else
    {
            <div class="container-fluid mt-5">
                <main role="main" class="pb-3">
                @RenderBody()
                </main>
            </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

    <!-- CodeMirror JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
