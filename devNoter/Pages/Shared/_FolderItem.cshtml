@model devNoter.Models.LanguageFolder

<li class="nav-item mb-1">
    <div class="d-flex justify-content-between align-items-center">
        <!-- Folder link -->
        <a asp-page="/Notes/GetAllNotes" asp-route-id="@Model.Id"
           class="nav-link text-dark">@Model.Name</a>

        <div>
            <!-- Add child folder button -->
            <button class="btn btn-sm btn-outline-success"
                    data-bs-toggle="modal"
                    data-bs-target="#createChildFolderModal-@Model.Id">
                +
            </button>

            <!-- Delete folder button -->
            <button class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteFolderModal-@Model.Id">
                –
            </button>
        </div>
    </div>

    
    <!-- Delete Folder Modal -->
    <div class="modal fade" id="deleteFolderModal-@Model.Id" tabindex="-1"
         aria-labelledby="deleteFolderModalLabel-@Model.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page="/LanguageFolder/DeleteLanguageFolder">
                    <input type="hidden" name="Folder.Id" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold text-danger" id="deleteFolderModalLabel-@Model.Id">
                            Delete Folder
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete the folder <strong>@Model.Name</strong>?</p>
                        <p class="text-danger"><small class="fw-bold">This action cannot be undone.</small></p>
                        <input type="hidden" name="Id" value="@Model.Id" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Create Child Folder Modal -->
    <div class="modal fade" id="createChildFolderModal-@Model.Id" tabindex="-1"
         aria-labelledby="createChildFolderModalLabel-@Model.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page="/LanguageFolder/CreateLanguageFolder">
                    <input type="hidden" name="LanguageFolder.ParentFolderId" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="createChildFolderModalLabel-@Model.Id">
                            Create Child Folder for @Model.Name
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="LanguageFolder_Name" class="form-label">Folder Name</label>
                            <input type="text" id="LanguageFolder_Name" name="LanguageFolder.Name" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Render child folders recursively -->
    @if (Model.ChildFolders != null && Model.ChildFolders.Any())
    {
        <ul class="nav flex-column ms-3">
            @foreach (var child in Model.ChildFolders)
            {
                @await Html.PartialAsync("_FolderItem", child)
            }
        </ul>
    }
</li>




