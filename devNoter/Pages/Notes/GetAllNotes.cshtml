@page "{id:int}"
@model devNoter.Pages.Notes.GetAllNotesModel
@{
}
<!--Folders in Folder-->
<div class="row mb-4 align-items-center">
    <div class="col">
        <h2>Folders in: <span class="text-dark">@Model.Folder.Name</span></h2>
    </div>
</div>
<div class="row mb-4 align-items-center">
    <div class="col-auto">
        <button class="btn btn-success"
        data-bs-toggle="modal"
        data-bs-target="#createChildFolderModalInFolder-@Model.Folder.Id">
            + Create New Folder
        </button>
    </div>

    <!-- Create Child Folder Modal In Folder -->
    <div class="modal fade" id="createChildFolderModalInFolder-@Model.Folder.Id" tabindex="-1"
    aria-labelledby="createChildFolderModalInFolderLabel-@Model.Folder.Id" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page="/LanguageFolder/CreateLanguageFolder">
                    <input type="hidden" name="LanguageFolder.ParentFolderId" value="@Model.Folder.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="createChildFolderModalInFolderLabel-@Model.Folder.Id">
                            Create A New Folder For Folder: @Model.Folder.Name
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="LanguageFolder_Name" class="form-label">Folder Name</label>
                            <input type="text" id="LanguageFolder_Name" name="LanguageFolder.Name" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
